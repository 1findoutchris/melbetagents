# ---------------------------------------------------------------------------
# melbetagents.org — server configuration
# Copy to .env.local for development. Never commit real values.
# All variables below are read on the server only (no NEXT_PUBLIC_ prefix),
# so they are never sent to the browser.
# ---------------------------------------------------------------------------

# REQUIRED — PostgreSQL connection string used to store applications.
# Example: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# TLS for the database connection. "require" = TLS with certificate
# verification (recommended for hosted Postgres). "no-verify" = TLS without
# verification (only if your provider uses a self-signed certificate).
# Leave empty for a local database without TLS.
DATABASE_SSL=

# REQUIRED in production — random secret used to hash applicant IP addresses
# for rate limiting, so raw IPs are never stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Telegram notifications for new applications (sent from the server only).
# SECRET: set these in your hosting provider's environment settings, never in Git.
# TELEGRAM_BOT_TOKEN: token of @melbetagentsorgbot from @BotFather.
# TELEGRAM_GROUP_CHAT_ID: your staff group's ID (negative number, see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# Optional: time zone for the "Submitted" line (IANA name). Default UTC.
TELEGRAM_TIMEZONE=

# Recommended: random secret protecting /api/notifications/retry (used by a scheduler).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# OPTIONAL — public site URL used for canonical/social metadata.
SITE_URL=https://melbetagents.org

# OPTIONAL — rate limit: maximum applications per IP per window (default 5 per 60 minutes).
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=60

# ---------------------------------------------------------------------------
# Search engines
# ---------------------------------------------------------------------------

# OPTIONAL — Google Search Console "HTML tag" verification code (only the
# content="..." value). Not needed if you verify the domain with a DNS TXT record.
GOOGLE_SITE_VERIFICATION=

# OPTIONAL — comma-separated hostnames that should 301/308-redirect to SITE_URL.
# Defaults to "www.<your domain>".
ALTERNATE_HOSTS=

# Set to "true" on staging/preview deployments to block indexing (pages send
# noindex, robots.txt permits reading it, sitemap is empty). Leave empty in production.
SITE_NOINDEX=
