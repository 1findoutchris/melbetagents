{
  "name": "melbetagents",
  "version": "1.0.0",
  "private": true,
  "description": "Payment agent recruitment website for melbetagents.org",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-search-routes.mjs && next build",
    "seo:routes": "node scripts/check-search-routes.mjs",
    "seo:check": "python3 scripts/check_seo.py",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "python3 scripts/build_assets.py",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "telegram:test": "node scripts/telegram-setup.mjs --test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.14",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
